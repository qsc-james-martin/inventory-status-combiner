-- Combines every design inventory item's status once per second.
-- Matches Q-SYS Status Combiner priority: highest numeric status code wins.
-- Lists all non-OK items; this plugin is not managed inventory itself.
-- Optional additional status input pins are combined too, matching the native
-- Status Combiner: Disable ignores an input, Suppress ignores it until its status
-- changes, Latch holds the last error until Reset. Blank labels default to "Input N".

PluginInfo = {
    Name = "Utility~Inventory Status Combiner",
    Version = "1.2.0",
    BuildVersion = "1.2.0",
    Id = "caff323a-b905-41ab-bd22-9ad19f705bea",
    Author = "James Martin",
    Description = "Combine all design inventory statuses without input wiring.",
    IsManaged = false,
    ShowDebug = true
}

local STATUS_NAMES = {
    [0] = "OK", [1] = "Compromised", [2] = "Fault",
    [3] = "Not Present / Unknown", [4] = "Missing", [5] = "Initializing"
}

function GetColor(props)
    return { 200, 200, 200 }
end

function GetPrettyName(props)
    return "Inventory Status Combiner  v" .. PluginInfo.Version
end

function GetProperties()
    return {
        { Name = "Additional Inputs", Type = "integer", Min = 0, Max = 64, Value = 0 },
        { Name = "Debug Print", Type = "enum", Choices = { "No", "Yes" }, Value = "No" }
    }
end

local function inputCount(props)
    return props["Additional Inputs"] and props["Additional Inputs"].Value or 0
end

function GetPins(props) return {} end
function GetComponents(props) return {} end
function GetWiring(props) return {} end

function GetControls(props)
    local controls = {
        { Name = "Status", ControlType = "Indicator", IndicatorType = "Status",
            Count = 1, PinStyle = "Output", UserPin = true },
        { Name = "OK", ControlType = "Indicator", IndicatorType = "Led",
            Count = 1, PinStyle = "Output", UserPin = true },
        { Name = "Compromised", ControlType = "Indicator", IndicatorType = "Led",
            Count = 1, PinStyle = "Output", UserPin = true },
        { Name = "Fault", ControlType = "Indicator", IndicatorType = "Led",
            Count = 1, PinStyle = "Output", UserPin = true }
    }
    local n = inputCount(props)
    if n > 0 then
        local function add(c) c.Count = n; controls[#controls + 1] = c end
        -- UserPin = false: input pins are always shown, not toggled in Control Pins.
        add({ Name = "InputStatus", ControlType = "Indicator", IndicatorType = "Status",
            PinStyle = "Input", UserPin = false })
        add({ Name = "InputLabel", ControlType = "Text", PinStyle = "Both", UserPin = true })
        add({ Name = "InputDisable", ControlType = "Button", ButtonType = "Toggle",
            PinStyle = "Both", UserPin = true })
        add({ Name = "InputSuppress", ControlType = "Button", ButtonType = "Toggle",
            PinStyle = "Both", UserPin = true })
        add({ Name = "InputLatch", ControlType = "Button", ButtonType = "Toggle",
            PinStyle = "Both", UserPin = true })
        add({ Name = "InputReset", ControlType = "Button", ButtonType = "Trigger",
            PinStyle = "Input", UserPin = true })
    end
    return controls
end

function GetControlLayout(props)
    local layout = {
        Status = { Style = "Status", Position = { 8, 8 }, Size = { 640, 160 }, FontSize = 11 },
        OK = { Style = "Led", Position = { 8, 172 }, Size = { 16, 16 }, Color = { 0, 200, 0 } },
        Compromised = { Style = "Led", Position = { 60, 172 }, Size = { 16, 16 }, Color = { 255, 140, 0 } },
        Fault = { Style = "Led", Position = { 168, 172 }, Size = { 16, 16 }, Color = { 220, 0, 0 } }
    }
    local graphics = {}
    local function label(text, x, y, w, align)
        graphics[#graphics + 1] = { Type = "Label", Text = text, Position = { x, y }, Size = { w, 16 },
            FontSize = 11, HTextAlign = align or "Center", Color = { 0, 0, 0 } }
    end
    label("OK", 28, 172, 24, "Left")
    label("Compromised", 80, 172, 80, "Left")
    label("Fault", 188, 172, 40, "Left")

    local n = inputCount(props)
    if n == 0 then return layout, graphics end

    local function key(name, i) return n > 1 and (name .. " " .. i) or name end
    local top = 196
    local y = top + 20
    local function button(name, i, x, color)
        layout[key("Input" .. name, i)] = { PrettyName = "Input " .. i .. "~" .. name, Style = "Button",
            Position = { x, y }, Size = { 40, 16 }, Color = color }
    end
    table.insert(graphics, 1, { Type = "GroupBox", Text = "Additional Inputs", HTextAlign = "Left",
        FontSize = 11, Fill = { 220, 220, 220 }, StrokeWidth = 1, CornerRadius = 4,
        Position = { 8, top }, Size = { 640, 44 + n * 20 } })
    label("Input", 12, y, 32)
    label("Disable", 48, y, 48)
    label("Suppress", 100, y, 56)
    label("Latch", 160, y, 48)
    label("Reset", 212, y, 48)
    label("Label", 264, y, 160)
    label("Status", 428, y, 216)
    for i = 1, n do
        y = y + 20
        label(tostring(i), 12, y, 32)
        button("Disable", i, 52, { 200, 0, 0 })
        button("Suppress", i, 108, { 255, 140, 0 })
        button("Latch", i, 164, { 220, 200, 0 })
        button("Reset", i, 216, { 0, 110, 200 })
        layout[key("InputLabel", i)] = { PrettyName = "Input " .. i .. "~Label", Style = "Text",
            Position = { 264, y }, Size = { 160, 16 }, FontSize = 11 }
        layout[key("InputStatus", i)] = { PrettyName = "Input " .. i .. "~Status", Style = "Status",
            Position = { 428, y }, Size = { 216, 16 }, FontSize = 11 }
    end
    return layout, graphics
end

if Controls then
    local debug = Properties["Debug Print"].Value == "Yes"
    local lastCode, lastMessage

    local function arr(c)
        if c == nil then return {} end
        local ok, first = pcall(function() return c[1] end)
        if ok and first ~= nil then return c end
        return { c }
    end

    local inStatus, inLabel = arr(Controls.InputStatus), arr(Controls.InputLabel)
    local inDisable, inSuppress = arr(Controls.InputDisable), arr(Controls.InputSuppress)
    local inLatch, inReset = arr(Controls.InputLatch), arr(Controls.InputReset)
    local latched, suppressedAt = {}, {}

    local function validCode(code)
        return type(code) == "number" and code == code and code >= 0 and code <= 5 and code % 1 == 0
    end

    local function inputName(i)
        local text = inLabel[i].String
        return text ~= "" and text or ("Input " .. i)
    end

    local function status(code, message)
        if code ~= lastCode or message ~= lastMessage then
            if code ~= 0 or debug then print("Inventory Status Combiner: " .. message) end
            lastCode, lastMessage = code, message
        end
        Controls.Status.Value = code
        Controls.Status.String = message
    end

    local function leds(ok, compromised, fault)
        Controls.OK.Boolean = ok
        Controls.Compromised.Boolean = compromised
        Controls.Fault.Boolean = fault
    end

    local function update()
        local ok, inventory = pcall(Design.GetInventory)
        if not ok or type(inventory) ~= "table" then
            status(2, "Cannot read design inventory: " .. tostring(inventory))
            leds(false, false, true)
            return
        end

        local count, worst, issues = 0, 0, {}
        local anyCompromised, anyFault = false, false
        local function note(code)
            worst = math.max(worst, code)
            if code == 1 then anyCompromised = true elseif code >= 2 then anyFault = true end
        end
        for _, item in pairs(inventory) do
            count = count + 1
            local name = type(item) == "table" and item.Name
            if type(name) ~= "string" or name == "" then
                note(2)
                issues[#issues + 1] = "Unnamed inventory item: status unavailable"
            else
                local source = item.Status
                if type(source) ~= "table" or type(source.Code) ~= "number"
                    or source.Code ~= source.Code or source.Code < 0 or source.Code > 5
                    or source.Code % 1 ~= 0 or type(source.Message) ~= "string" then
                    note(2)
                    issues[#issues + 1] = name .. ": status unavailable"
                else
                    note(source.Code)
                    if source.Code ~= 0 then
                        issues[#issues + 1] = name .. ": "
                            .. (source.Message ~= "" and source.Message or STATUS_NAMES[source.Code])
                    end
                end
            end
        end

        local inputs = 0
        for i = 1, #inStatus do
            local raw, rawMessage = inStatus[i].Value, inStatus[i].String
            local code, message = raw, rawMessage
            if not validCode(code) then code, message = 2, "invalid status" end
            if inLatch[i].Boolean then
                if code ~= 0 then latched[i] = { code = code, message = message } end
                if latched[i] then code, message = latched[i].code, latched[i].message end
            else
                latched[i] = nil
            end
            if inSuppress[i].Boolean then
                local seen = suppressedAt[i]
                if not seen then
                    suppressedAt[i] = { value = raw, message = rawMessage }
                elseif seen.value ~= raw or seen.message ~= rawMessage then
                    inSuppress[i].Boolean = false
                    suppressedAt[i] = nil
                end
            else
                suppressedAt[i] = nil
            end
            if not inDisable[i].Boolean and not inSuppress[i].Boolean then
                inputs = inputs + 1
                note(code)
                if code ~= 0 then
                    issues[#issues + 1] = inputName(i) .. ": "
                        .. (message ~= "" and message or STATUS_NAMES[code])
                        .. (latched[i] and raw == 0 and " (latched)" or "")
                end
            end
        end

        leds(worst == 0 and (count > 0 or inputs > 0), anyCompromised, anyFault)
        if count == 0 and inputs == 0 then
            status(3, "No inventory items in this design.")
        elseif worst == 0 then
            status(0, "OK - All " .. count .. " inventory items"
                .. (inputs > 0 and (" and " .. inputs .. " inputs.") or "."))
        else
            table.sort(issues)
            status(worst, STATUS_NAMES[worst] .. " - " .. table.concat(issues, ", "))
        end
    end

    for i = 1, #inStatus do
        if inLabel[i].String == "" then inLabel[i].String = "Input " .. i end
        inStatus[i].EventHandler = update
        inDisable[i].EventHandler = update
        inSuppress[i].EventHandler = function()
            suppressedAt[i] = nil
            update()
        end
        inLatch[i].EventHandler = update
        inLabel[i].EventHandler = update
        inReset[i].EventHandler = function()
            latched[i] = nil
            update()
        end
    end

    InventoryStatusCombinerPollTimer = Timer.New()
    InventoryStatusCombinerPollTimer.EventHandler = update
    update()
    InventoryStatusCombinerPollTimer:Start(1)
end
